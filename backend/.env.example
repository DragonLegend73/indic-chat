# ==============================================================
# Indic-Chat — Environment Configuration
# ==============================================================
# Copy this file to .env and fill in your values

# --- LLM Provider ---
# Options: "ollama" | "openrouter" | "groq"
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma4:e2b
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter (free tier fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Groq (free tier fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Teacher Dashboard Auth ---
# Generate with: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your-password'))"
TEACHER_PASSWORD_HASH=$2b$12$LJ3m4ys2ShGNqYF.bKgN7.X1IVsWZKOkNc0EOjDfCKXJ4oYJ4.2Yq
JWT_SECRET=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Database ---
SQLITE_DB_URL=sqlite+aiosqlite:///./data/indic_chat.db

# --- RAG ---
CHROMA_DB_PATH=./data/chroma_db
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_MULTILINGUAL=paraphrase-multilingual-MiniLM-L12-v2

# --- AI4Bharat Model Paths ---
INDICLID_MODEL_PATH=./models/indiclid
INDICTRANS2_EN_INDIC_MODEL=ai4bharat/indictrans2-en-indic-dist-200M
INDICTRANS2_INDIC_EN_MODEL=ai4bharat/indictrans2-indic-en-dist-200M

# --- Rate Limiting ---
RATE_LIMIT=10/minute

# --- App ---
APP_ENV=development
DEMO_MODE=true
